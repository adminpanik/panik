# PANIK environment template — copy to .env and fill in.
# .env is gitignored; NEVER commit real keys.
#
# IMPORTANT: only VITE_-prefixed vars are exposed to the frontend bundle.
# Everything else is backend-only. Do not add secrets with a VITE_ prefix.

# ── API CORS allowlist (backend only) ──────────────────────────────────
# Comma-separated list of EXACT frontend origins allowed to call the API
# cross-origin (scheme + host + optional port, no path, no trailing slash).
# REQUIRED when NODE_ENV=production - the API refuses to boot without it, and
# the Dockerfile hard-sets NODE_ENV=production, so an unset value on Railway is
# a crash-loop, not a warning. "*" and a blank/whitespace value are refused
# too: the first restores wildcard CORS, the second matches nothing and fails
# every cross-origin call silently.
# Not needed when the SPA is served same-origin (Vercel rewrites /api/* to this
# service), but set it anyway - the guard has no way to know.
#   CORS_ORIGINS=https://panik.xyz,https://www.panik.xyz
# Leave blank locally: non-production falls back to allowing any origin.
CORS_ORIGINS=

# ── API edge / proxy topology (backend only) ───────────────────────────
# How many proxies sit in front of the Express API and APPEND to
# X-Forwarded-For. This is what the rate limiter keys on, so it must match
# reality: too high and every user shares one bucket (the edge's egress IP)
# and the whole site 429s itself; too low and the value is client-controlled,
# which is a complete rate-limit bypass. Default 2.
#   2 = browser → Vercel edge → Railway edge → app  (vercel.json rewrites
#       /api/* to Railway — this is the production path)
#   1 = clients hit Railway directly (no Vercel rewrite in front)
#   0 = no proxy at all (local dev, docker, private networking)
# Verify after any topology change by logging one request's raw
# x-forwarded-for and counting the entries.
TRUSTED_PROXY_HOPS=0
# OPTIONAL single-value header carrying the true client IP, e.g.
# x-vercel-forwarded-for. Leave BLANK unless the origin cannot be reached
# directly: any header our edge sets is forgeable by a caller that skips the
# edge, and the Railway public domain is directly reachable.
TRUSTED_CLIENT_IP_HEADER=

# ── Slice 1 (scoring engine) ────────────────────────────────────────────
# CoinGecko Demo plan key (free, 30 calls/min) — asset risk price history
# Get: coingecko.com → API → Demo plan signup
COINGECKO_API_KEY=

# Dune API key (free tier) — week-1 calibration data pulls, analytics only.
# ALSO powers the wallet DeFi-persona profiler (/api/profile): lifetime
# cross-chain lending history via saved query 7771860. See
# docs/technical-docs/WALLET_PROFILER.md.
# Get: dune.com → Settings → API
DUNE_API_KEY=

# OpenRouter key — AI narration for the persona profiler (model
# google/gemini-2.5-flash). OPTIONAL: if blank, /api/profile still works and
# returns deterministic fallback prose. Backend-only — never VITE_-prefix.
# Get: openrouter.ai → Keys
OPENROUTER_API_KEY=

# ── Slice 2 (active mode + wallet) ──────────────────────────────────────
# Alchemy app keys (free tier) — Base mainnet reads + Base Sepolia testnet.
# Backend-only (server/, scripts/, the watch worker) — SECRET, never VITE_-prefix.
# Get: alchemy.com → create app per network
ALCHEMY_API_KEY_BASE_MAINNET=
ALCHEMY_API_KEY_BASE_SEPOLIA=

# Which chain the SCORING path reads: `mainnet` (default) or `testnet`.
# One switch for the API server, the watch worker and `npm run score:wallet`
# (server/scoringChain.ts + packages/scoring/src/chains.ts): it picks the RPC,
# the Aave market addresses, which protocol readers run, and whether market
# context is obtainable at all. Backend-only; the browser is TOLD which chain
# its positions came from in the /api/positions response, so a client env can
# never disagree with the read.
#
# `testnet` = Base Sepolia 84532, the chain the exit executor is deployed on
# (src/panik-core/lib/exit.generated.ts), so scores and exits describe the same
# position. Only Aave V3 is listed there, and its faucet assets have no
# CoinGecko listing and no DefiLlama TVL, so the asset-risk and systemic terms
# come back NOT MEASURED and the composite is weighted over position health and
# protocol safety. Health factor and USD values stay exact: they are read from
# the market's own oracle.
#
# Requires the Alchemy key for the chain you select (the one above, or the
# Sepolia one). Anything other than `testnet` resolves to mainnet.
PANIK_SCORING_CHAIN=
# Browser RPC endpoints for the in-app exit flow. OPTIONAL — leave blank and the
# flow uses the public Base endpoints (sepolia.base.org / mainnet.base.org first,
# then publicnode, then drpc) and fails over between them automatically.
#
# PUBLIC BY DESIGN: VITE_ vars are compiled into the client bundle, so whatever
# you set here is readable by anyone who opens devtools. Put a URL that is safe
# to publish — a provider endpoint restricted to your domain, or a node you run.
# NEVER paste the ALCHEMY_API_KEY_* URLs above into these: those keys are
# backend-only, and a VITE_ name publishes them to every visitor.
# A value that is not an http(s) URL is ignored, and the public list is used.
VITE_BASE_RPC_URL=
VITE_BASE_SEPOLIA_RPC_URL=

# WalletConnect / Reown Cloud project ID (free) — wagmi connect modal.
# Public by design, hence the VITE_ prefix.
# Get: cloud.reown.com → create project
VITE_WALLETCONNECT_PROJECT_ID=

# DefiLlama: no key required. Chainlink: read on-chain via Alchemy RPC.

# ── Supabase (data + auth layer — waitlist CRM, watch state, Mirror sink) ──
# Get all of these: supabase.com → your project → Project Settings.
#
# Frontend (public by design — RLS is the security boundary, not the key):
# Settings → API → Project URL + publishable key
# (older projects call it "anon" key; either works in these slots)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend/worker only (SECRET — bypasses RLS; never VITE_-prefix, never
# ship to a browser). Settings → API → secret key ("service_role" on
# older projects). Used by the Watch worker + Edge Function admin tasks.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Postgres connection string (SECRET) — dashboard → Connect → use the
# ⚠ SESSION POOLER string (port 5432, host aws-X-[region].pooler.supabase.com,
# user postgres.[PROJECT-REF]). Why not the others:
#   - "Direct connection" (db.[ref].supabase.co) is IPv6-ONLY on new
#     projects → ENOTFOUND from IPv4-only networks (verified 2026-06-13)
#   - Transaction pooler (port 6543) breaks long-lived connections
# Session pooler = IPv4-compatible AND holds connections → works for both
# the Goldsky Mirror sink and the Watch worker. Same DB password.
# NOTE: the api-server AND the Watch worker call transactionPoolerUrl(), which
# auto-rewrites this string's port 5432 -> 6543 (the transaction pooler) because
# the session pooler times out from some networks. Paste the session-pooler
# string here; the rewrite is transparent. Set SUPABASE_DB_POOL_URL to override.
SUPABASE_DB_URL=

# ── Goldsky (event indexing — Advisor "what happened" feed + reconciliation) ──
# Free Starter tier: 3 subgraph workers, 100k entities, 1 Mirror pipeline,
# 1M records/mo. Get: app.goldsky.com → create project → Settings → API keys.
# API key is used by the CLI (`goldsky login`) and pipeline/webhook config;
# the project ID scopes deployments. Backend-only — never VITE_-prefix these.
GOLDSKY_PROJECT_ID=
GOLDSKY_API_KEY=

# ── Slice 3 (Telegram near-liquidation alerts) ─────────────────────────
# Bot token from @BotFather. BACKEND/WORKER ONLY - never VITE_-prefix.
# Used by the Watch worker (sends alerts) and the webhook (replies).
TELEGRAM_BOT_TOKEN=
# A random string you choose; passed to setWebhook as secret_token and checked
# on every incoming update (X-Telegram-Bot-Api-Secret-Token). Backend-only.
TELEGRAM_WEBHOOK_SECRET=
# Bot username (no @) for the deep-link t.me/<username>?start=<code>. Public by
# design (it is in the link), hence VITE_. Read by /api/telegram/link too.
VITE_TELEGRAM_BOT_USERNAME=
# Production base URL for the one-time `npm run telegram:setup` (setWebhook),
# e.g. https://panik.xyz. Not needed at runtime. Can be passed as a CLI arg.
TELEGRAM_PUBLIC_BASE_URL=

# ── Wallet-ownership proof (SIWE / EIP-4361) ──────────────────────────────
# Comma-separated list of RFC 3986 authorities allowed to collect a signature
# for POST /api/wallets/register and POST /api/telegram/link, e.g.
#   SIWE_ALLOWED_DOMAINS=panik.fi,www.panik.fi
# This is the domain binding: without it, ANY site could prompt personal_sign
# over our message offline and POST the result here, and the victim would never
# have to visit PANIK. REQUIRED in production — when NODE_ENV=production and
# this is unset, every proof is refused (503) rather than silently accepting any
# domain. Local dev defaults to localhost:3000 / :5173. Backend-only.
# Nonces live in public.auth_nonces (20260806000001) via SUPABASE_URL /
# SUPABASE_SECRET_KEY above, so those are now required for registration too.
SIWE_ALLOWED_DOMAINS=

# ── Founding User Escrow (hidden page — /founding) ─────────────────────
# Contract address on Base (deployed via `forge script` — see contracts/README.md).
# Public by design (readable on Basescan), hence the VITE_ prefix.
# Must be the deployed contract ADDRESS (0x + 40 hex chars) — NOT the deploy
# transaction hash (0x + 64 hex chars). An invalid value disables the flow.
VITE_ESCROW_CONTRACT_ADDRESS=
# Chain ID: 8453 (Base mainnet) or 84532 (Base Sepolia for testing).
VITE_ESCROW_CHAIN_ID=84532

# ── Product trial codes (2-in-1 business card - /try + /admin) ─────────────
# Shared secret gating the campaign admin console. Sent as the X-Admin-Key
# header and checked by /api/admin/*. Still supported for scripts and curl;
# the browser console signs in with Supabase instead (below). Choose a long
# random string. BACKEND-ONLY - never VITE_-prefix. Redemption + app-open
# (/api/try/*) reuse the existing SUPABASE_URL / SUPABASE_SECRET_KEY above.
ADMIN_ACCESS_KEY=

# The ONE account allowed through /admin. The console signs in with Supabase
# Auth (email + password) and sends the access token as a bearer; the server
# resolves that token against Supabase on every /api/admin/* request and
# refuses any other address (server/adminIdentity.ts). Optional: the default
# below is compiled in. BACKEND value is the one that enforces.
ADMIN_ALLOWED_EMAIL=admin.panik@gmail.com
# Same address, for the client's courtesy message only. Never a boundary.
VITE_ADMIN_EMAIL=admin.panik@gmail.com

# ── Delegated exits (Phase 2.B — session-key API) ──────────────────────────
# The backend verifies EIP-712 ExitPermits and reads revocation state from the
# EXECUTOR's chain (Base Sepolia 84532 today, from src/panik-core/lib/
# exit.generated.ts — NOT the mainnet 8453 SIWE uses). RPC resolution: this
# override wins; else the ALCHEMY_API_KEY_BASE_SEPOLIA app above; else the public
# https://sepolia.base.org node. Backend-only. Delegation rows live in
# public.exit_delegations (20260809000002) via SUPABASE_URL / SUPABASE_SECRET_KEY.
EXIT_EXECUTOR_RPC_URL=

# ── Exit relayer (Phase 4.A — signs + submits atomicExitFor) ───────────────
# The relayer loop lives in scripts/watch-worker.ts. It reads live delegations,
# checks the user's SIGNED health-factor trigger against the engine's score,
# simulates atomicExitFor, and only then submits. Every knob below fails towards
# "did not spend money" when unset.
#
# THE KILL SWITCH. Default OFF. Only "true", "1" or "yes" (case-insensitive) arm
# it; a typo, a blank, or anything else reads as OFF. While OFF the loop still
# evaluates and SIMULATES every candidate and logs a relayer.would-submit event,
# so the decision can be watched against real positions before anyone arms it.
# LEAVE THIS BLANK until the dry-run output has been reviewed.
RELAYER_ENABLED=

# Signer selection: "local" (default) or "kms".
RELAYER_SIGNER_KIND=
# LOCAL/TESTNET ONLY. Comma-separated hot private keys, one per pool EOA (>=1).
# A pool of N gives N independent nonce sequences, so one stuck transaction
# stalls only its own queue. These keys pay GAS and nothing else: a user's
# delegation is a signature, the permit names no recipient, and the executor
# always pays permit.user — so a stolen relayer key drains PANIK's gas wallet
# and cannot touch a single unit of user funds. Still: never commit these, and
# do not use them on mainnet.
RELAYER_PRIVATE_KEYS=
# MAINNET PLAN (adapter documented, implementation deferred — see
# server/relayerSigner.ts). Comma-separated KMS key ids/ARNs, one per pool EOA,
# asymmetric ECC_SECG_P256K1 / SIGN_VERIFY. Requires AWS_REGION and IRSA-style
# credentials (AWS_ROLE_ARN + AWS_WEB_IDENTITY_TOKEN_FILE); no static AWS keys.
RELAYER_KMS_KEY_IDS=

# Spend and blast-radius caps. Blank = the defaults in server/relayerPolicy.ts.
RELAYER_MAX_SUBMISSIONS_PER_TICK=      # default 3
RELAYER_MAX_SUBMISSIONS_PER_HOUR=      # default 20
RELAYER_MAX_GAS_PER_TX=                # default 3000000 (simulated gas)
RELAYER_MIN_BALANCE_WEI=               # default 2000000000000000 (~0.002 ETH)
RELAYER_MAX_ATTEMPTS_PER_PERMIT=       # default 3
RELAYER_STUCK_AFTER_MS=                # default 90000, then a >=10% fee bump
# Latest-block age (seconds) past which the chain is treated as stopped and the
# relayer submits nothing. Base has had multi-hour sequencer outages, and a
# receipt cannot tell "pending" from "sequencer down".
RELAYER_SEQUENCER_STALE_SEC=           # default 120

# Reserves a position read covers, comma-separated. Only an asset the executor
# TRACKS can appear in a leg, so this is a list rather than a scan. Blank =
# the USDC + WETH pair from exit.generated.ts that the UI's ExitFlow reads.
RELAYER_RESERVES=

# The relayer submits on the EXECUTOR's chain and reuses EXIT_EXECUTOR_RPC_URL
# above. Attempt rows live in public.relayer_attempts (20260810000001) via
# SUPABASE_URL / SUPABASE_SECRET_KEY; that ledger is what stops a crash-restart
# re-firing a permit, so the relayer refuses to ARM without it.

# Fork integration test only (server/exitRelayer.fork.test.ts). Skipped unless
# set; requires `anvil` on PATH. Points at a Base Sepolia RPC to fork LOCALLY —
# the test never sends a transaction to a live network.
RELAYER_FORK_RPC=