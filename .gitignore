node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Personal daily logs — not for the shared repo
Progress/

# AI session transcripts and local editor/agent state
claude_session_*.md
.claude/

# Build output at repo root (see `clean` script) + deploy caches + OS noise
server.js
.vercel/
Thumbs.db

# Backtest runtime artifacts (fetch cache is regenerable via the pull scripts;
# curated datasets/ stay tracked — they back docs/technical-docs/BACKTEST_RESULTS.md)
scripts/backtest/data/
scripts/backtest/.tmp-*.sql

# Foundry (smart contract build artifacts)
# contracts/lib/ is NOT ignored — forge deps are git submodules, and ignoring
# them is what broke `forge build` on a fresh clone.
contracts/out/
contracts/cache/
# foundry.lock is not tracked: forge writes the dependency key with the host
# OS's path separator ("lib\\forge-std" on Windows, "lib/forge-std" on Linux),
# so a committed copy is dirty on whichever platform did not generate it. The
# submodule gitlink in .gitmodules/.git is the real pin.
contracts/foundry.lock

# Hardhat (executor/ build output — same treatment as contracts/ above: the
# generated trees are ignored, the sources and the lockfile are tracked).
# executor/abi/ is regenerable output of `npm run export:abi`, which reads
# executor/artifacts/ — it is not a source of truth and is not imported here.
executor/node_modules/
executor/artifacts/
executor/cache/
executor/typechain-types/
executor/abi/

# Playwright MCP snapshots and local screenshots. `/*.png` already covers the
# `phase*.png` / `baseline.png` names verification passes keep producing, so
# they are not listed again — a second pattern for a subset of the first only
# reads as though it were doing something the first does not.
.playwright-mcp/
/*.png
/*.jpeg
/*.jpg
